# Copy this file to .env and adjust the values

# Google OAuth files
CREDENTIALS_PATH=credentials.json
TOKEN_PATH=token.json

# Gmail search query used to find application emails
GMAIL_QUERY=has:attachment (filename:pdf OR filename:docx) subject:application

# Ollama model (must be pulled first: ollama pull llama3.1)
OLLAMA_MODEL=llama3.1

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File that remembers which emails were already processed
PROCESSED_IDS_PATH=data/processed_ids.json

# Folder for downloaded CV files and the size limit per file (in MB)
CV_DOWNLOAD_DIR=data/cvs
MAX_ATTACHMENT_MB=10

# Folder for extracted CV text and the minimum text length of a readable CV
EXTRACTED_DIR=data/output/extracted
MIN_CV_TEXT_CHARS=50

# Job description text and the structured requirements HR reviews
JOB_DESCRIPTION_PATH=job/job_description.txt
JOB_REQUIREMENTS_PATH=job/job_requirements.json

# Local Ollama server and the longest text sent to the LLM
OLLAMA_HOST=http://localhost:11434
MAX_LLM_INPUT_CHARS=12000

# Cosine similarity limits for matching (0 = unrelated, 1 = same meaning)
SIMILARITY_MEETS=0.55
SIMILARITY_PARTIAL=0.35
SIMILARITY_RELEVANT=0.40

# Ranking: weight of a Must-Have in the score, and where the report is saved
MUST_HAVE_WEIGHT=2
REPORT_PATH=data/output/screening_report.json
